<StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- HEADER -->
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="7*" />
        </Grid.ColumnDefinitions>
        <Image
            x:Name="bbb_logo"
            Grid.Column="0"
            HorizontalAlignment="Center"
            Tag="common\assets\BBB_Logo.jpg"
            VerticalAlignment="Top"
            Width="auto">
        </Image>
        <StackPanel Grid.Column="1">
            <TextBlock
                FontSize="24"
                FontWeight="Bold"
                Grid.Column="1"
                Padding="10 0 0 0"
                TextWrapping="Wrap"
                Text="Setup + Configuration" />
            <TextBlock
                FontSize="12"
                Grid.Column="1"
                Padding="10 0 0 0"
                TextWrapping="Wrap"
                Text="Set up the Shared Parameters, Area Schemes, and other required infrastrcture to use the Program Data Silo Tools." />
        </StackPanel>
    </Grid>

    <Border Padding="10" Margin="8,0,12,0">
        <StackPanel>
            <Expander Name="myExpander" Background="Tan"
                HorizontalAlignment="Left" Header="Instructions"
                ExpandDirection="Down" IsExpanded="False" Width="Auto">
                <TextBlock TextWrapping="Wrap">
                    Lorem ipsum dolor sit amet, consectetur
                    adipisicing elit, sed do eiusmod tempor incididunt ut
                    labore et dolore magna aliqua
                </TextBlock>
            </Expander>


            <TextBlock TextWrapping="Wrap" Margin="0,0,0,0">
                The purpose of the "Program Data Silo Tools" are to standardize how information
                related to spatial programming and unit data is handled.
            </TextBlock>
            <TextBlock TextWrapping="Wrap" Margin="0,15,0,0">
                Each piece of "Program" is associated with one "Program Data Silo" Family. The
                PDS
                Families act as the "single source of truth" for all manually entered data (eg
                unit
                number, market info, etc).
                The Program Data Silo Tools include scripts to:
                - Find relevant Areas and harvest sqft information from the Areas to the Data
                Silos
                - Create and Update "Program Volume" Families based on the shape of the Areas
                - Place Program Volume Families in the right location(s) in the model, including
                managing stacked duplicates
                - Push data from the Program Data Silos to the Program Volume Families, for
                tagging in
                any view
            </TextBlock>
            <Image
                HorizontalAlignment="Center"
                Margin="0,15,0,0"
                Tag="pdso\assets\data_silo_concept.png"
                VerticalAlignment="Top"
                Width="auto">
            </Image>
            <TextBlock TextWrapping="Wrap" Margin="0,15,0,0">
                This script uses the location of each data silo object to identify which areas
                it is
                inside of (and should therefore pull data from).
            </TextBlock>
            <TextBlock TextWrapping="Wrap" Margin="0,15,0,0">
                <Run FontWeight="Bold">This is a semi-automated tool. Using it incorrectly or
                carelessly
                    can result in large amounts of changes to your project file.</Run> If you are in
                any way uncertain about proper usage of this workflow, please reach out to the
                Design and Construction Technology Department, we are happy to provide guidance and
                training. </TextBlock>
            <TextBlock TextWrapping="Wrap" Margin="0,15,0,0">
                <Run FontWeight="Bold">Be sure to save and sync BEFORE running any automation
                    tools!</Run>
            </TextBlock>

            <!-- Proof of Concept: Progress Bar Demo -->
            <Border BorderBrush="#2196F3" BorderThickness="2" Margin="0,30,0,0" Padding="15"
                CornerRadius="5">
                <StackPanel>
                    <TextBlock FontSize="16" FontWeight="Bold" Text="WPF ProgressBar Demo"
                        Margin="0,0,0,10" />
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,10">
                        This demonstrates WPF ProgressBar control with data binding and background
                        threading.
                        Click the button below to process 100 items with progress updates.
                    </TextBlock>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,10">
                        <TextBlock Text="Current Count: " FontSize="18" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding counter_value}" FontSize="24" FontWeight="Bold"
                            Foreground="#2196F3" VerticalAlignment="Center" Margin="10,0,0,0" />
                    </StackPanel>

                    <ProgressBar Value="{Binding progress_value}" Maximum="{Binding progress_max}"
                        Height="20" Margin="0,10,0,10" />

                    <TextBlock Text="{Binding progress_status}" FontSize="14" FontStyle="Italic"
                        Foreground="#666666" Margin="0,0,0,10" />

                    <Button x:Name="StartProgressButton" Content="Start Progress Demo"
                        Style="{DynamicResource ActionButton}"
                        Margin="0,5,0,0" HorizontalAlignment="Left" Padding="15,8" />
                </StackPanel>
            </Border>

            <Grid Margin="0,50,0,30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <Button x:Name="Tab01NextButton" Grid.Column="1"
                    Style="{DynamicResource ActionButton}"
                    Margin="30,0,0,0" Content="I understand, continue." />
            </Grid>
        </StackPanel>


    </Border>
</StackPanel>
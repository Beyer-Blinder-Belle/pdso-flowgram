<StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Header with Logo and Title -->
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="7*" />
        </Grid.ColumnDefinitions>
        <Image
            x:Name="bbb_logo"
            Grid.Column="0"
            HorizontalAlignment="Center"
            Tag="common\assets\BBB_Logo.jpg"
            VerticalAlignment="Top"
            Width="auto" />
        <StackPanel Grid.Column="1">
            <TextBlock FontSize="24" FontWeight="Bold"
                Padding="10 0 0 0" TextWrapping="Wrap"
                Text="Data Harvesting &amp; Sync" />
            <TextBlock FontSize="12" Padding="10 0 0 0"
                TextWrapping="Wrap"
                Text="Run validation checks and synchronize program data from areas to data silos and program volumes." />
        </StackPanel>
    </Grid>

    <!-- Main Content Border -->
    <Border Padding="10" Margin="8,0,12,0">
        <StackPanel>

            <!-- Section 1: Preflight Checks -->
            <Border BorderBrush="#2196F3" BorderThickness="2" Padding="15"
                Margin="0,0,0,15" CornerRadius="5">
                <StackPanel Margin="10">
                    <!-- Header with Refresh Button -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            FontSize="14"
                            FontWeight="Bold"
                            Text="1. Preflight Checks"
                            VerticalAlignment="Center" />
                        <Button
                            Grid.Column="1"
                            x:Name="RefreshPreflightButton"
                            Height="24"
                            Width="24"
                            Padding="2"
                            Background="Transparent"
                            BorderThickness="0"
                            ToolTip="Refresh preflight checks">
                            <Image x:Name="refresh_reload_icon"
                                Width="20"
                                Height="20"
                                Tag="common\assets\refresh_reload_icon.png"
                                Stretch="Uniform" />
                        </Button>
                    </Grid>

                    <!-- Preflight Status Message -->
                    <Border BorderBrush="#E0E0E0" BorderThickness="1" Padding="10"
                        CornerRadius="3" Margin="0,0,0,10"
                        Background="{Binding preflight_status_background}">
                        <StackPanel Orientation="Horizontal">
                            <Image x:Name="PreflightStatusIcon"
                                Width="16" Height="16"
                                Margin="0,0,8,0"
                                VerticalAlignment="Top" />
                            <TextBlock Text="{Binding preflight_status_message}"
                                TextWrapping="Wrap"
                                FontWeight="Bold"
                                HorizontalAlignment="Left"
                                Foreground="{Binding preflight_status_foreground}" />
                        </StackPanel>
                    </Border>

                    <Expander x:Name="PreflightChecksExpander"
                        Header="View Details"
                        IsExpanded="{Binding preflight_has_issues}">
                        <StackPanel Margin="10,10,0,0">

                            <!-- Config Validation Group -->
                            <TextBlock FontSize="12" FontWeight="Bold"
                                Text="Config Validation" Margin="0,5,0,5" />
                            <StackPanel Margin="15,0,0,10">
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <Image x:Name="CheckConfigIcon" Width="16" Height="16"
                                        Margin="0,0,4,0" />
                                    <TextBlock x:Name="CheckConfigText"
                                        Text="{Binding check_config_status}"
                                        TextWrapping="Wrap" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <Image x:Name="CheckLevelMappingsIcon" Width="16" Height="16"
                                        Margin="0,0,4,0" />
                                    <TextBlock x:Name="CheckLevelMappingsText"
                                        Text="{Binding check_level_mappings_status}"
                                        TextWrapping="Wrap" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Basic Area Validation Group -->
                            <TextBlock FontSize="12" FontWeight="Bold"
                                Text="Basic Area Validation" Margin="0,5,0,5" />
                            <StackPanel Margin="15,0,0,10">
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <Image x:Name="CheckAreaSchemesIcon" Width="16" Height="16"
                                        Margin="0,0,4,0" />
                                    <TextBlock x:Name="CheckAreaSchemesText"
                                        Text="{Binding check_area_schemes_status}"
                                        TextWrapping="Wrap" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <Image x:Name="CheckAreaInstancesIcon" Width="16" Height="16"
                                        Margin="0,0,4,0" />
                                    <TextBlock x:Name="CheckAreaInstancesText"
                                        Text="{Binding check_area_instances_status}"
                                        TextWrapping="Wrap" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <Image x:Name="CheckGroupedAreasIcon" Width="16" Height="16"
                                        Margin="0,0,4,0" />
                                    <TextBlock x:Name="CheckGroupedAreasText"
                                        Text="{Binding check_grouped_areas_status}"
                                        TextWrapping="Wrap" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Generic Models Validation Group -->
                            <TextBlock FontSize="12" FontWeight="Bold"
                                Text="Generic Models Validation" Margin="0,5,0,5" />
                            <StackPanel Margin="15,0,0,10">
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <Image x:Name="CheckDataSiloFamilyIcon" Width="16" Height="16"
                                        Margin="0,0,4,0" />
                                    <TextBlock x:Name="CheckDataSiloFamilyText"
                                        Text="{Binding check_data_silo_family_loaded_status}"
                                        TextWrapping="Wrap" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <Image x:Name="CheckDataSiloInstancesIcon" Width="16"
                                        Height="16" Margin="0,0,4,0" />
                                    <TextBlock x:Name="CheckDataSiloInstancesText"
                                        Text="{Binding check_data_silo_instances_status}"
                                        TextWrapping="Wrap" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <Image x:Name="CheckUidUniquenessIcon" Width="16" Height="16"
                                        Margin="0,0,4,0" />
                                    <TextBlock x:Name="CheckUidUniquenessText"
                                        Text="{Binding check_uid_uniqueness_status}"
                                        TextWrapping="Wrap" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <Image x:Name="CheckUidPatternIcon" Width="16" Height="16"
                                        Margin="0,0,4,0" />
                                    <TextBlock x:Name="CheckUidPatternText"
                                        Text="{Binding check_uid_pattern_status}"
                                        TextWrapping="Wrap" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <Image x:Name="CheckGenericModelParamsIcon" Width="16"
                                        Height="16" Margin="0,0,4,0" />
                                    <TextBlock x:Name="CheckGenericModelParamsText"
                                        Text="{Binding check_generic_model_parameters_status}"
                                        TextWrapping="Wrap" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Per Area Checks Group -->
                            <TextBlock FontSize="12" FontWeight="Bold"
                                Text="Per Area Checks" Margin="0,5,0,5" />
                            <StackPanel Margin="15,0,0,10">
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <Image x:Name="CheckAreasMultipleDataSilosIcon" Width="16"
                                        Height="16" Margin="0,0,4,0" />
                                    <TextBlock x:Name="CheckAreasMultipleDataSilosText"
                                        Text="{Binding check_areas_multiple_data_silos_status}"
                                        TextWrapping="Wrap" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <Image x:Name="CheckAreasNoDataSilosIcon" Width="16" Height="16"
                                        Margin="0,0,4,0" />
                                    <TextBlock x:Name="CheckAreasNoDataSilosText"
                                        Text="{Binding check_areas_no_data_silos_status}"
                                        TextWrapping="Wrap" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Per Data Silo Checks Group -->
                            <TextBlock FontSize="12" FontWeight="Bold"
                                Text="Per Data Silo Checks" Margin="0,5,0,5" />
                            <StackPanel Margin="15,0,0,10">
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <Image x:Name="CheckDataSilosPartialContainmentIcon" Width="16"
                                        Height="16" Margin="0,0,4,0" />
                                    <TextBlock x:Name="CheckDataSilosPartialContainmentText"
                                        Text="{Binding check_data_silos_partial_containment_status}"
                                        TextWrapping="Wrap" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <Image x:Name="CheckDataSilosNoContainmentIcon" Width="16"
                                        Height="16" Margin="0,0,4,0" />
                                    <TextBlock x:Name="CheckDataSilosNoContainmentText"
                                        Text="{Binding check_data_silos_no_containment_status}"
                                        TextWrapping="Wrap" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Worksharing Group -->
                            <TextBlock FontSize="12" FontWeight="Bold"
                                Text="Worksharing Availability Checks" Margin="0,5,0,5" />
                            <StackPanel Margin="15,0,0,10">
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <Image x:Name="CheckDataSilosAvailabilityIcon" Width="16"
                                        Height="16" Margin="0,0,4,0" />
                                    <TextBlock x:Name="CheckDataSilosAvailabilityText"
                                        Text="{Binding check_data_silos_availability_status}"
                                        TextWrapping="Wrap" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <Image x:Name="CheckProgramVolumesAvailabilityIcon" Width="16"
                                        Height="16" Margin="0,0,4,0" />
                                    <TextBlock x:Name="CheckProgramVolumesAvailabilityText"
                                        Text="{Binding check_program_volumes_availability_status}"
                                        TextWrapping="Wrap" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <Image x:Name="CheckAreasAvailabilityIcon" Width="16"
                                        Height="16" Margin="0,0,4,0" />
                                    <TextBlock x:Name="CheckAreasAvailabilityText"
                                        Text="{Binding check_areas_availability_status}"
                                        TextWrapping="Wrap" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Expander>

                    <!-- Note about errors and warnings -->
                    <TextBlock TextWrapping="Wrap" FontSize="10" Foreground="#666666"
                        Margin="0,10,0,0">
                        <Run Text="Note: Errors " />
                        <Run FontWeight="Bold" Text="must" />
                        <Run Text=" be resolved before the script can run. " />
                        <LineBreak />
                        <Run
                            Text="Warnings should be reviewed, but will not stop the script from running." />
                        <LineBreak />
                    </TextBlock>

                </StackPanel>
            </Border>

            <!-- Section 2: Configuration -->
            <Border BorderBrush="#2196F3" BorderThickness="2" Padding="15"
                Margin="0,0,0,15" CornerRadius="5">
                <StackPanel Margin="10">
                    <TextBlock
                        FontSize="14"
                        FontWeight="Bold"
                        Text="2. Script Settings"
                        Margin="0,0,0,10" />

                    <!-- Data Silos Subsection -->
                    <TextBlock
                        FontWeight="Bold"
                        Text="Data Silos"
                        Margin="0,10,0,5" />

                    <Border BorderBrush="#E0E0E0" BorderThickness="1" Padding="10"
                        CornerRadius="3" Margin="0,0,0,0">
                        <StackPanel>
                            <TextBlock TextWrapping="Wrap" FontSize="10" Foreground="#666666"
                                Margin="0,0,0,10"
                                Text="Harvest area data from Revit Area objects and sync to Data Silo instances based on spatial containment." />

                            <!-- Data Silo Workset Enforcement -->
                            <TextBlock Text="Data Silo Workset Enforcement:"
                                FontWeight="Bold"
                                Margin="0,10,0,5" />
                            <ComboBox x:Name="AreaHarvestWorksetComboBox"
                                Margin="0,0,0,5" SelectedIndex="0">
                                <ComboBoxItem Content="Fix (if configured)" />
                                <ComboBoxItem Content="Warn (if configured)" />
                                <ComboBoxItem Content="Do Nothing" />
                            </ComboBox>
                            <TextBlock
                                TextWrapping="Wrap"
                                FontSize="10"
                                Foreground="#666666"
                                Margin="0,0,0,10"
                                Text="If a Data Silo Workset is configured, this setting determines whether to automatically move Data Silos to the correct workset, or just warn if they are on the wrong workset." />

                            <!-- Data Silo Pinning -->
                            <TextBlock Text="Data Silo Pinning:"
                                FontWeight="Bold"
                                Margin="0,10,0,5" />
                            <ComboBox x:Name="AreaHarvestPinningComboBox"
                                Margin="0,0,0,5" SelectedIndex="0">
                                <ComboBoxItem Content="Pin" />
                                <ComboBoxItem Content="Maintain" />
                                <ComboBoxItem Content="Unpin" />
                            </ComboBox>
                            <TextBlock
                                TextWrapping="Wrap"
                                FontSize="10"
                                Foreground="#666666"
                                Margin="0,0,0,10"
                                Text="Control whether Data Silo instances are pinned after area harvest. Pinning prevents accidental movement but may interfere with coordination workflows." />
                        </StackPanel>
                    </Border>

                    <!-- Program Volumes Subsection -->
                    <TextBlock
                        FontWeight="Bold"
                        Text="Program Volumes"
                        Margin="0,20,0,5" />

                    <Border BorderBrush="#E0E0E0" BorderThickness="1" Padding="10"
                        CornerRadius="3" Margin="0,0,0,0">
                        <StackPanel>
                            <TextBlock TextWrapping="Wrap" FontSize="10" Foreground="#666666"
                                Margin="0,0,0,10"
                                Text="Control geometry creation and updates for Program Volume families, including workset placement and pinning behavior." />

                            <!-- Update Geometry -->
                            <TextBlock Text="Update Geometry:"
                                FontWeight="Bold"
                                Margin="0,10,0,5" />
                            <ComboBox x:Name="ProgramVolumeGeometryUpdateComboBox"
                                Margin="0,0,0,5" SelectedIndex="0">
                                <ComboBoxItem Content="Yes - Use Geometry Cache" />
                                <ComboBoxItem Content="Yes - Recompute All Geometry (slow)" />
                                <ComboBoxItem Content="No" />
                            </ComboBox>
                            <TextBlock
                                TextWrapping="Wrap"
                                FontSize="10"
                                Foreground="#666666"
                                Margin="0,0,0,10"
                                Text="Cache mode uses geometry hashing to update only changed volumes. Recompute mode regenerates all geometry regardless of changes (useful for troubleshooting but slower)." />

                            <!-- Update Data -->
                            <TextBlock Text="Update Data:"
                                FontWeight="Bold"
                                Margin="0,10,0,5" />
                            <ComboBox x:Name="ProgramVolumeDataUpdateComboBox"
                                Margin="0,0,0,5" SelectedIndex="0">
                                <ComboBoxItem Content="Yes" />
                                <ComboBoxItem Content="No" />
                            </ComboBox>
                            <TextBlock
                                TextWrapping="Wrap"
                                FontSize="10"
                                Foreground="#666666"
                                Margin="0,0,0,10"
                                Text="Choose whether to sync parameter data from Data Silos to Program Volume instances. Yes copies all PDSO parameters; No leaves instance parameters unchanged." />

                            <!-- Workset Enforcement -->
                            <TextBlock Text="Workset Enforcement:"
                                FontWeight="Bold"
                                Margin="0,10,0,5" />
                            <ComboBox x:Name="ProgramVolumeGeometryWorksetComboBox"
                                Margin="0,0,0,5" SelectedIndex="0">
                                <ComboBoxItem Content="Fix (if configured)" />
                                <ComboBoxItem Content="Warn (if configured)" />
                                <ComboBoxItem Content="Do Nothing" />
                            </ComboBox>
                            <TextBlock
                                TextWrapping="Wrap"
                                FontSize="10"
                                Foreground="#666666"
                                Margin="0,0,0,10"
                                Text="If a Program Volume Workset is configured, this setting determines whether to automatically move Program Volumes to the correct workset, or just warn if they are on the wrong workset." />

                            <!-- Program Volume Pinning -->
                            <TextBlock Text="Program Volume Pinning:"
                                FontWeight="Bold"
                                Margin="0,10,0,5" />
                            <ComboBox x:Name="ProgramVolumeGeometryPinningComboBox"
                                Margin="0,0,0,5" SelectedIndex="0">
                                <ComboBoxItem Content="Pin" />
                                <ComboBoxItem Content="Maintain" />
                                <ComboBoxItem Content="Unpin" />
                            </ComboBox>
                            <TextBlock
                                TextWrapping="Wrap"
                                FontSize="10"
                                Foreground="#666666"
                                Margin="0,0,0,10"
                                Text="Control whether Program Volume instances are pinned after geometry updates. Pinning prevents accidental movement but may interfere with coordination workflows." />
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Border>

            <!-- Section 3: Run PDSO Script -->
            <Border BorderBrush="#2196F3" BorderThickness="2" Padding="15"
                Margin="0,0,0,15" CornerRadius="5">
                <StackPanel Margin="10">
                    <TextBlock
                        FontSize="14"
                        FontWeight="Bold"
                        Text="3. Run PDSO Script"
                        Margin="0,0,0,10" />

                    <TextBlock
                        TextWrapping="Wrap"
                        FontSize="10"
                        Foreground="#666666"
                        Margin="0,0,0,15"
                        Text="This will run scripts to calculate spatial relationships and push PDSO information where it needs to go. This will overwrite data on the Program Volumes, using data from the Data Silos. Please save and sync your work prior to running this tool." />

                    <!-- Run Button -->
                    <Button x:Name="RunSyncButton"
                        Content="Run Sync Process"
                        Style="{DynamicResource ActionButton}"
                        IsEnabled="{Binding can_run_sync}"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,20" />

                    <!-- Current Step -->
                    <TextBlock Text="Current Step:"
                        FontWeight="Bold"
                        Margin="0,10,0,5" />
                    <TextBlock Text="{Binding current_step}"
                        TextWrapping="Wrap"
                        Margin="15,0,0,15" />

                    <!-- Progress Bar -->
                    <TextBlock Text="Progress:"
                        FontWeight="Bold"
                        Margin="0,0,0,5" />
                    <ProgressBar Value="{Binding progress_value}"
                        Maximum="{Binding progress_max}"
                        Height="20" Margin="0,0,0,5" />
                    <TextBlock Text="{Binding progress_status}"
                        FontSize="12" FontStyle="Italic"
                        Foreground="#666666" Margin="0,0,0,15" />

                    <!-- Completion Message -->
                    <Border BorderBrush="#4CAF50" BorderThickness="2" Padding="10"
                        CornerRadius="3" Margin="0,10,0,0"
                        Visibility="{Binding completion_message_visibility}">
                        <TextBlock Text="{Binding completion_message}"
                            TextWrapping="Wrap"
                            FontWeight="Bold"
                            Foreground="#4CAF50" />
                    </Border>

                </StackPanel>
            </Border>

        </StackPanel>
    </Border>

</StackPanel>
{
  "_comment": "Working views to create. 'area_scheme' is the PDSO scheme key; it is looked up in the model's Project Config area scheme mapping, so it follows renamed schemes. Set enabled to true to create views for the other schemes too. Name tokens: {level}, {area_scheme}. exclude_levels leaves out levels whose names match (case-insensitive, * is a wildcard).",
  "on_existing": "skip",
  "views": [
    {
      "name": "PDSO - GSF - {level}",
      "view_type": "AreaPlan",
      "area_scheme": "PDSO - GSF",
      "levels": "all",
      "exclude_levels": ["*Roof*", "*Parapet*"],
      "template": "PDSO - Area Plan - Working",
      "enabled": true
    },
    {
      "name": "PDSO - NSF - {level}",
      "view_type": "AreaPlan",
      "area_scheme": "PDSO - NSF",
      "levels": "all",
      "exclude_levels": ["*Roof*", "*Parapet*"],
      "template": "PDSO - Area Plan - Working",
      "enabled": false
    },
    {
      "name": "PDSO - ZFA - {level}",
      "view_type": "AreaPlan",
      "area_scheme": "PDSO - ZFA",
      "levels": "all",
      "exclude_levels": ["*Roof*", "*Parapet*"],
      "template": "PDSO - Area Plan - Working",
      "enabled": false
    },
    {
      "name": "PDSO - Program Volumes - 3D",
      "view_type": "ThreeD",
      "template": "PDSO - 3D - Program Volumes",
      "enabled": true
    }
  ]
}
